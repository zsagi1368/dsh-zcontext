{
  "name": "dsh-zcontext",
  "description": "Model-driven incremental context folding plugin for the DeepSeek Harness (official surface replace channel, cache-aware, compaction-compatible).",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-management",
    "compaction",
    "prompt-cache",
    "token-budget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/dsh-zcontext.git"
  },
  "homepage": "https://github.com/zsagi1368/dsh-zcontext#readme",
  "bugs": {
    "url": "https://github.com/zsagi1368/dsh-zcontext/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electron/asar": "^4.3.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "test": "tsdown && vitest run"
  }
}
